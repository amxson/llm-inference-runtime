{
  "name": "llm-runtime-trace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
